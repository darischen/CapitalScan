# The MCP server's read-only role (ADR 027). Create it with
#   cscan db grant-readonly --password <pw>
# Unset, the server falls back to DATABASE_URL_RESEARCH and says so loudly:
# it still works, and the second layer of read-only enforcement is off.
DATABASE_URL_MCP=
CAPSCAN_ENV=development
