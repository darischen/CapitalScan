[Unit]
Description=CapitalScan nightly, after the 13:00 PT close

[Timer]
# **Not Saturday** (2026-09-19). Friday's 13:15 run already ingested Friday's
# session, so a Saturday run fetches nothing: the price fetchers skip a
# non-trading day and the rest is a recompute of unchanged rows, measured at
# 51 minutes on 2026-09-13. Its only unique value was retrying a Friday that
# failed both 13:15 and 19:00, and Sunday's run is the same retry one day
# later.
#
# It also collided with `weekly`, which starts Sat 00:00 and ran 11h55m on
# 2026-09-19. Nothing locks the two against each other, so an overlapping
# nightly syncs serving mid-backtest and rewrites labels under the refit.
# Dropping Saturday removes the overlap that has actually happened; a weekly
# running past Sunday 13:15 would still meet one. -> BACKLOG.md
OnCalendar=Sun,Mon,Tue,Wed,Thu,Fri *-*-* 13:15:00
# A second full attempt the same evening. If the 13:15 batch exhausted its
# retry burst (see the .service), this gives it a fresh one. resume-check
# in run_job.sh makes it a no-op when 13:15 (or a retry) already succeeded.
OnCalendar=Sun,Mon,Tue,Wed,Thu,Fri *-*-* 19:00:00
# Fire a run that was missed entirely because the machine was off at 13:15.
# With Saturday dropped, a Friday run missed entirely catches up on Sunday.
Persistent=true
# Persistent only covers a MISSED fire. A crash mid-run leaves the timer
# already triggered for the day, so a reboot at 13:40 gets no catch-up.
# OnBootSec re-fires the service; run_job.sh's resume-check then decides
# whether the chain still needs to run (ADR 160).
OnBootSec=3min
Unit=capitalscan-nightly.service

[Install]
WantedBy=timers.target
