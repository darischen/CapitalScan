# Copy to .env.local and fill in. `jobs/db.py::_load_env` loads .env.local
# then .env from the repo root, for every `cscan` command. Never commit the
# real file -- .env.local is gitignored.
#
# The research machine (nightly / weekly / monthly / sync) needs only the
# four in the first block. The rest are for the poller's notifications, the
# MCP server, and the web app, and can be left blank on a machine that does
# not run those.

# --- required on the research machine -------------------------------------

# Local research Postgres. `localhost` when Postgres runs on this machine.
# Bind BOTH address families when exposing it (see CLAUDE.md): an IPv4-only
# bind makes `localhost` resolve to ::1 first and wait ~2s per connect.
DATABASE_URL_RESEARCH=postgresql://capscan:capscan@localhost:5432/capitalscan

# The Pi's serving Postgres, over the LAN. Host and db name are parsed out
# of this by scripts/wait_and_poll.ps1, so keep it a real URL.
DATABASE_URL_SERVING=postgresql+psycopg://capscan:capscan@192.168.1.30:5432/capitalscan_serving

# SEC EDGAR requires a descriptive UA with contact info or it 403s.
SEC_USER_AGENT="Your Name your.email@example.com"

# Finnhub free tier is enough for the earnings calendar.
FINNHUB_API_KEY=

# --- environment label ---------------------------------------------------
# Free-form; shows up in `runs` and logs. e.g. prod / dev / laptop.
CAPSCAN_ENV=prod

# --- poller notifications (optional) -----------------------------------
# jobs/notify.py fans out to whichever of these is set. All blank = no
# alerts, the poll still runs and writes the database.
NOTIFY_DISCORD_WEBHOOK=
NOTIFY_NTFY_TOPIC=
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_SMTP_TO=

# --- MCP server (optional) --------------------------------------------
# `cscan mcp serve` refuses to start without a token (ADR 027).
# DATABASE_URL_MCP unset = dev-only fallback to the read-write research
# role; `cscan db grant-readonly` provisions capscan_ro for real use.
MCP_BEARER_TOKEN=
DATABASE_URL_MCP=

# --- chat / tools (optional) -----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- web app, Pi only ----------------------------------------------
SITE_PASSWORD=
SITE_AUTH_DISABLED=1
