<?xml version="1.0" encoding="UTF-16"?>
<!-- Template. {{REPO}} is substituted by scripts\install_schedule.ps1 with
     the repo root, so this file carries no machine-specific path. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>CapitalScan nightly: pull_live_records, ingest chain, indicators, events, sync to serving. Runs after the 13:00 PT close.</Description>
    <URI>\CapitalScan nightly</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-08-03T13:15:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <!-- ADR 080's catch-up: a run missed while the machine was off fires at
         next boot regardless of time of day. -->
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <ExecutionTimeLimit>PT4H</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions>
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -File "{{REPO}}\scripts\run_job.ps1" nightly</Arguments>
      <WorkingDirectory>{{REPO}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
